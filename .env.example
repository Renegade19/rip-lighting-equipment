# Порт веб-сервиса
PORT=3000

# Параметры подключения к Minio (см. docker-compose.yml)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=lighting-equipment
# Ключи нужны для загрузки фото и видео светильников (чтение бакета открыто всем)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Параметры подключения к PostgreSQL (см. docker-compose.yml)
DB_HOST=localhost
DB_PORT=5455
DB_USERNAME=lighting
DB_PASSWORD=lighting
DB_DATABASE=lighting_equipment

# JWT: ключ подписи токенов и срок их жизни (формат Go: 1h, 30m)
JWT_SECRET_KEY=lumicalc-dev-secret
JWT_EXPIRES_IN=1h

# Redis: чёрный список токенов после logout (см. docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
