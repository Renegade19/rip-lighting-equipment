# Порт SSR-приложения
PORT=3000

# Параметры подключения к Minio (см. docker-compose.yml)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=lighting-equipment

# Параметры подключения к PostgreSQL (см. docker-compose.yml)
DB_HOST=localhost
DB_PORT=5455
DB_USERNAME=lighting
DB_PASSWORD=lighting
DB_DATABASE=lighting_equipment
